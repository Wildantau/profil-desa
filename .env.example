############################################
# APPLICATION
############################################

APP_NAME="Profile Desa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

############################################
# LOGGING
############################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

############################################
# DATABASE
############################################

# ===== OPTION 1 (LOCAL DEV) =====
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# ===== OPTION 2 (HOSTING MYSQL) =====
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nama_database
# DB_USERNAME=nama_user
# DB_PASSWORD=password_database

############################################
# SESSION
############################################

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

############################################
# CACHE & QUEUE
############################################

CACHE_STORE=file
QUEUE_CONNECTION=sync

############################################
# FILESYSTEM
############################################

FILESYSTEM_DISK=public

############################################
# MAIL (default log only)
############################################

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@desa.local"
MAIL_FROM_NAME="${APP_NAME}"

############################################
# REDIS (optional)
############################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

############################################
# VITE
############################################

VITE_APP_NAME="${APP_NAME}"
